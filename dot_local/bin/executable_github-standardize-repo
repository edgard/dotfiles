#!/usr/bin/env bash
exec python3 - "$@" <<'PYTHON'
"""Apply the repository's least-privilege GitHub policy idempotently."""

from __future__ import annotations

import argparse
import json
import re
import subprocess
import sys
from typing import Any, Optional, Sequence


RULESET_NAME = "Default Branch Protection"
API_VERSION = "2026-03-10"


def parser() -> argparse.ArgumentParser:
    result = argparse.ArgumentParser(description=__doc__)
    result.add_argument("repository", help="OWNER/REPOSITORY")
    result.add_argument("--with-ci", metavar="CHECKS", default="", help="comma-separated status checks")
    result.add_argument("--dry-run", action="store_true")
    result.add_argument("--verbose", "-v", action="store_true")
    return result


def gh_api(
    endpoint: str,
    *,
    method: str = "GET",
    payload: Optional[dict[str, Any]] = None,
    jq: Optional[str] = None,
    verbose: bool = False,
) -> Any:
    command = [
        "gh",
        "api",
        endpoint,
        "--header",
        "Accept: application/vnd.github+json",
        "--header",
        f"X-GitHub-Api-Version: {API_VERSION}",
    ]
    if method != "GET":
        command.extend(("--method", method))
    if payload is not None:
        command.extend(("--input", "-"))
    if jq:
        command.extend(("--jq", jq))
    process = subprocess.run(
        command,
        input=json.dumps(payload, separators=(",", ":")) if payload is not None else None,
        capture_output=True,
        text=True,
        check=False,
    )
    if verbose:
        print("$", " ".join(command), file=sys.stderr)
        if payload is not None:
            print(json.dumps(payload, indent=2, sort_keys=True), file=sys.stderr)
    if process.returncode:
        raise RuntimeError(process.stderr.strip() or f"GitHub API call failed: {endpoint}")
    if not process.stdout.strip():
        return None
    try:
        return json.loads(process.stdout)
    except json.JSONDecodeError:
        return process.stdout.strip()


def ruleset_payload(checks: Sequence[str]) -> dict[str, Any]:
    rules: list[dict[str, Any]] = [
        {"type": "deletion"},
        {"type": "non_fast_forward"},
        {"type": "required_linear_history"},
        {
            "type": "pull_request",
            "parameters": {
                "allowed_merge_methods": ["squash", "rebase"],
                "dismiss_stale_reviews_on_push": False,
                "require_code_owner_review": False,
                "require_last_push_approval": False,
                "required_approving_review_count": 0,
                "required_review_thread_resolution": True,
            },
        },
    ]
    if checks:
        rules.append(
            {
                "type": "required_status_checks",
                "parameters": {
                    "do_not_enforce_on_create": False,
                    "strict_required_status_checks_policy": True,
                    "required_status_checks": [{"context": check} for check in checks],
                },
            }
        )
    return {
        "name": RULESET_NAME,
        "target": "branch",
        "enforcement": "active",
        "bypass_actors": [
            {
                "actor_id": 5,
                "actor_type": "RepositoryRole",
                "bypass_mode": "pull_request",
            }
        ],
        "conditions": {"ref_name": {"include": ["~DEFAULT_BRANCH"], "exclude": []}},
        "rules": rules,
    }


def desired_requests(
    repository: str,
    checks: Sequence[str],
) -> list[tuple[str, str, Optional[dict[str, Any]]]]:
    return [
        (
            "PATCH",
            f"repos/{repository}",
            {
                "allow_auto_merge": False,
                "allow_merge_commit": False,
                "allow_rebase_merge": True,
                "allow_squash_merge": True,
                "allow_update_branch": True,
                "delete_branch_on_merge": True,
                "has_discussions": False,
                "has_projects": False,
                "has_wiki": False,
                "squash_merge_commit_message": "PR_BODY",
                "squash_merge_commit_title": "PR_TITLE",
            },
        ),
        (
            "PATCH",
            f"repos/{repository}",
            {
                "security_and_analysis": {
                    "dependabot_security_updates": {"status": "enabled"},
                    "secret_scanning": {"status": "enabled"},
                    "secret_scanning_push_protection": {"status": "enabled"},
                }
            },
        ),
        ("PUT", f"repos/{repository}/vulnerability-alerts", None),
        ("PUT", f"repos/{repository}/private-vulnerability-reporting", None),
        (
            "PATCH",
            f"repos/{repository}/code-scanning/default-setup",
            {"state": "configured"},
        ),
        (
            "PUT",
            f"repos/{repository}/actions/permissions/workflow",
            {
                "default_workflow_permissions": "read",
                "can_approve_pull_request_reviews": False,
            },
        ),
        (
            "PUT",
            f"repos/{repository}/actions/permissions",
            {"enabled": True, "allowed_actions": "selected", "sha_pinning_required": True},
        ),
        (
            "PUT",
            f"repos/{repository}/actions/permissions/selected-actions",
            {"github_owned_allowed": True, "verified_allowed": True, "patterns_allowed": []},
        ),
    ]


def describe(repository: str, checks: Sequence[str]) -> None:
    print(f"Repository: {repository}")
    print("default_branch: preserved")
    print("default_workflow_permissions: read")
    print("can_approve_pull_request_reviews: false")
    print("Allowed actions: GitHub-owned and verified publishers only")
    print("SHA pinning: required")
    print("Dependabot security updates: enabled")
    print("CodeQL default setup: configured")
    print(f"Ruleset: {RULESET_NAME}")
    print("Rules: deletion, non-fast-forward, linear history, pull requests, resolved conversations")
    print("Mandatory reviewers: 0")
    print("Administrator bypass: pull-request-only")
    if checks:
        print("Required status checks:", ", ".join(checks))


def main(argv: Optional[Sequence[str]] = None) -> int:
    arguments = parser().parse_args(argv)
    if not re.fullmatch(r"[^/\s]+/[^/\s]+", arguments.repository):
        parser().error("repository must use OWNER/REPOSITORY format")
    checks = tuple(check.strip() for check in arguments.with_ci.split(",") if check.strip())
    describe(arguments.repository, checks)
    if arguments.dry_run:
        return 0

    try:
        repository = gh_api(f"repos/{arguments.repository}", verbose=arguments.verbose)
        default_branch = repository.get("default_branch") if isinstance(repository, dict) else None
        if not default_branch:
            raise RuntimeError("GitHub did not return the current default branch")
        print(f"Current default branch preserved: {default_branch}")

        for method, endpoint, payload in desired_requests(arguments.repository, checks):
            gh_api(endpoint, method=method, payload=payload, verbose=arguments.verbose)

        existing = gh_api(f"repos/{arguments.repository}/rulesets", verbose=arguments.verbose) or []
        ruleset_id = next(
            (entry.get("id") for entry in existing if entry.get("name") == RULESET_NAME),
            None,
        )
        endpoint = (
            f"repos/{arguments.repository}/rulesets/{ruleset_id}"
            if ruleset_id is not None
            else f"repos/{arguments.repository}/rulesets"
        )
        gh_api(
            endpoint,
            method="PUT" if ruleset_id is not None else "POST",
            payload=ruleset_payload(checks),
            verbose=arguments.verbose,
        )
        for entry in existing:
            if entry.get("name") == "Master Protection":
                gh_api(
                    f"repos/{arguments.repository}/rulesets/{entry['id']}",
                    method="DELETE",
                    verbose=arguments.verbose,
                )
    except RuntimeError as error:
        print(f"Error: {error}", file=sys.stderr)
        return 1

    print("Repository policy applied successfully.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
PYTHON
