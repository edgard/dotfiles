#!/usr/bin/env python3
"""Installed entry point for the explicit dotfiles update manager."""

from __future__ import annotations

import os
import subprocess
import sys
from pathlib import Path


def source_root() -> Path:
    configured = os.environ.get("CHEZMOI_SOURCE_DIR")
    if configured:
        return Path(configured).expanduser()

    checkout = Path(__file__).resolve().parents[2]
    if (checkout / "extras" / "update_manager.py").is_file():
        return checkout

    result = subprocess.run(
        ["chezmoi", "source-path"],
        capture_output=True,
        text=True,
        check=False,
    )
    if result.returncode:
        raise SystemExit("unable to locate the Chezmoi source directory")
    return Path(result.stdout.strip())


sys.path.insert(0, str(source_root() / "extras"))
from update_manager import main  # noqa: E402


if __name__ == "__main__":
    raise SystemExit(main())
